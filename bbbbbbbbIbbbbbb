local json = require("json")

function main(request)
    local body = request.body
    local data = json.decode(body)

    if not data or data.key ~= "jrsqpBI5VZpt6PPnLG-Z" then
        return {
            status = 401,
            headers = { ["Content-Type"] = "application/json" },
            body = json.encode({ status = "error", message = "Key inválida" })
        }
    end

    local flingSpeed = 270 -- Aqui sua lógica da IA pode ficar dinâmica

    return {
        status = 200,
        headers = { ["Content-Type"] = "application/json" },
        body = json.encode({ status = "ok", flingSpeed = flingSpeed })
    }
end